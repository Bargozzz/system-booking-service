{
  "info": {
    "name": "Mini Booking Service",
    "description": "REST API for the Mini Booking Service. Run 'Login' first — it auto-saves the access token into the collection variable {{access_token}}, which every protected request reuses automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/login"
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/refresh"
          }
        }
      ]
    },
    {
      "name": "Schedules (public)",
      "item": [
        {
          "name": "Search schedules",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/schedules?origin=Jakarta&destination=Bandung",
              "host": ["{{base_url}}"],
              "path": ["api", "schedules"],
              "query": [
                { "key": "origin", "value": "Jakarta" },
                { "key": "destination", "value": "Bandung" },
                { "key": "date", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "View seats for schedule 1",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/schedules/1/seats"
          }
        }
      ]
    },
    {
      "name": "Bookings (protected)",
      "item": [
        {
          "name": "Lock seat 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/seats/1/lock"
          }
        },
        {
          "name": "Confirm booking for seat 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/seats/1/confirm"
          }
        }
      ]
    }
  ]
}
